1b:Tae5,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is The Customized Shop?","acceptedAnswer":{"@type":"Answer","text":"We're Pakistan's favourite personalized gift store, operating since 2020. We sell 100% customizable gifts: mugs, cushions, frames, lockets, LED lamps, couple watches, bracelets, phone cases, wallets, and more. We deliver gifts all over Pakistan."}},{"@type":"Question","name":"Do you deliver customized gifts all over Pakistan?","acceptedAnswer":{"@type":"Answer","text":"Yes. We deliver to every city in Pakistan: Karachi, Lahore, Islamabad, Rawalpindi, Faisalabad, Multan, Peshawar, Quetta, Sialkot, Hyderabad, Gujranwala, Abbottabad, and anywhere else. If you're in Pakistan, we'll get your gift to you."}},{"@type":"Question","name":"How long does gifts delivery take?","acceptedAnswer":{"@type":"Answer","text":"Karachi orders typically arrive in 1-2 days. All other cities in Pakistan receive orders within 3-5 days depending on location."}},{"@type":"Question","name":"Is there a minimum order for free delivery?","acceptedAnswer":{"@type":"Answer","text":"Yes, orders above Rs 2,000 get free delivery anywhere in Pakistan. Orders below that are charged a standard delivery fee."}},{"@type":"Question","name":"How do I customize my gifts in Pakistan?","acceptedAnswer":{"@type":"Answer","text":"Browse any product, click Customize, and enter your personalization details: names, photos, messages. Then confirm your order via WhatsApp, and we handle the rest."}},{"@type":"Question","name":"What occasions do your customized gifts cover?","acceptedAnswer":{"@type":"Answer","text":"All of them. Birthday gifts, anniversary gifts, marriage gifts, Mother's Day gifts, Father's Day gifts, Eid gifts, Valentine's Day gifts, teachers' gifts, and more. We have 13 gift categories with hundreds of designs."}},{"@type":"Question","name":"What's the best customized gifts price in Pakistan?","acceptedAnswer":{"@type":"Answer","text":"Bracelets and lockets start from Rs 600. Cushions from Rs 700. Mugs from Rs 850. Frames from Rs 699. Full birthday and anniversary deals start from Rs 1,200. Everything is priced honestly, right on the product page."}},{"@type":"Question","name":"Are your products of good quality?","acceptedAnswer":{"@type":"Answer","text":"Our 4.9-star rating from 500+ customers speaks for itself. Every product is printed with care, packed properly, and delivered exactly as shown. What you see is what you get."}},{"@type":"Question","name":"What makes you the best gift shop in Pakistan?","acceptedAnswer":{"@type":"Answer","text":"We customize everything. We price honestly. We deliver everywhere. We respond on WhatsApp. And we've been making people happy since 2020. That's the whole formula."}}]}3:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"LocalBusiness\",\"name\":\"The Customized Shop\",\"url\":\"https://thecustomizedshop.pk/\",\"telephone\":\"03148337494\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Jamshed Road\",\"addressLocality\":\"Karachi\",\"addressCountry\":\"PK\"},\"sameAs\":[\"https://www.instagram.com/thecustomizedshop1/\"],\"description\":\"Shop unique personalized gifts in Pakistan: custom mugs, cushions, frames, lamps & more. 100% customizable. Order on WhatsApp. Fast delivery.\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1b"}}],"$L1c","$L1d","$L1e","$L1f"]
